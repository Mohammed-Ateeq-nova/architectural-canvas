# Server Options
PORT=5000

# SMTP Configuration (Drop in your values when ready)
# Host examples: smtp.gmail.com (Gmail), smtp.mailgun.org (Mailgun), smtp.sendgrid.net (SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender Credentials
# For Gmail, SMTP_PASS must be a 16-character App Password (not your real password)
# Retrieve one from: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# Recipient (Target email address where submissions are delivered)
SMTP_TO=mohd.ateeq.march@gmail.com
